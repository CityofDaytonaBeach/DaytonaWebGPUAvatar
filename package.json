{
  "name": "daytona-webgpu-avatar",
  "version": "0.1.0",
  "description": "Browser-native, GPU-resident, persistent digital-human runtime engine powered by WebGPU",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc",
    "build:demo": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "webgpu",
    "digital-human",
    "avatar",
    "real-time",
    "avatar-sdk",
    "gpu-compute",
    "skeletal-animation"
  ],
  "license": "MIT",
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
